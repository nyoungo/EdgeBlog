// Cloudflare Worker 项目配置。
// 文档：https://developers.cloudflare.com/workers/wrangler/configuration/
//
// 用 .jsonc 而不是 .toml：一键部署按钮（Deploy to Cloudflare）的解析器比
// wrangler 更严，官方 41 个按钮模板全部是 json/jsonc。格式必须保持「严格 JSON」，
// 不要写尾逗号（wrangler 容忍，按钮解析器不容忍）。
{
  "name": "edge-blog",
  "compatibility_date": "2026-11-10",
  "compatibility_flags": ["nodejs_compat"],

  // Worker 入口：API、R2 媒体代理、SEO 外壳、RSS / sitemap / robots，
  // 以及「定时自动写文」的 scheduled 定时器。
  "main": "functions/worker.ts",

  // 静态资源：Vite 把前端产物输出到 dist/，通过 ASSETS 绑定提供。
  // run_worker_first 让所有请求先进入 Worker，由 worker.ts 决定是走 API、
  // 媒体、feed、SEO 外壳还是静态资源（顺序与旧的 Pages Functions 入口一致）。
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "none"
  },

  // Cron Trigger — 定时轮询自动化任务。
  // 任务的实际执行时间由 automation_tasks.next_run_at 决定，这里只负责以固定
  // 频率唤醒 Worker（Pages 不支持 Cron Trigger，这也是迁移到 Worker 的原因）。
  // 5 分钟一次足以覆盖到分钟的排期精度。
  "triggers": {
    "crons": ["*/5 * * * *"]
  },

  // Bindings
  // 一键部署会按这里的名字创建 D1 / R2 / KV 并把新的 ID 回填到你的仓库副本；
  // 手动部署时把 ID 换成自己账号里的资源即可。

  // D1 — relational data (posts, comments, settings, ...)
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "edge-blog",
      "database_id": "055686f4-1e23-4d09-9036-d511d5f02de4"
    }
  ],

  // R2 — media library / image uploads
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "edge-blog-media"
    }
  ],

  // KV — config cache + rate limiting counters
  "kv_namespaces": [
    {
      "binding": "CACHE",
      "id": "17f2c666debb4590be75cfa7d8879ede"
    }
  ],

  // Workers AI — default AI provider (no API key required inside the Worker)
  "ai": {
    "binding": "AI"
  },

  // 非敏感变量。SECRET（JWT_SECRET 等）必须留在 .dev.vars.example /
  // `wrangler secret put`，绝不能写在这里。
  "vars": {
    "ENVIRONMENT": "production",
    // Cookie name for the admin session.
    "SESSION_COOKIE": "eb_session"

    // 下面这些是「不配也能跑」的可选项，故意不在这里声明：
    // 一键部署表单会把 vars 逐项变成填写框，写成空字符串就等于要求部署的人必须
    // 填点什么。代码里全部按 undefined 处理，效果与空字符串一致。
    //
    // 站点对外地址（canonical / RSS / sitemap / OG，同时自动加入 CORS / CSRF 白名单）。
    // 不声明 = 自动跟随当前访问域名（workers.dev 与自定义域名都正确，推荐）。
    // 需要固定地址时取消注释并改成自己的域名：
    // "SITE_URL": "https://blog.example.com",
    //
    // 上传图片的公开前缀：图片以相对路径 /media/<key> 保存，换域名不用迁数据。
    // 仅当 R2 桶绑定了独立的自定义域名时才需要设置。
    // "MEDIA_PUBLIC_BASE": "https://media.example.com",
    //
    // 额外允许的跨域来源（逗号分隔）；同源始终允许，"*" 会被忽略。
    // "ALLOWED_ORIGINS": "https://admin.example.com",
    //
    // 联网搜索兜底（Cloudflare Web Search API）：默认网关 default、源头 exa。
    // "AI_GATEWAY_ID": "default",
    // "SEARCH_PROVIDER": "exa",
    // "SEARCH_BYOK_ALIAS": "default"
  }
}
